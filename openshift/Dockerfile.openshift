FROM registry.ci.openshift.org/ocp/builder:rhel-9-golang-1.26-openshift-5.0 AS builder

WORKDIR /build
COPY . .
RUN GO111MODULE=on CGO_ENABLED=0 GOOS=${GOOS} GOPROXY=${GOPROXY} go build \
  -ldflags="-w -s -X 'main.version=${VERSION}'" \
  -o=manager \
  main.go

RUN cd openshift/capi-ipam-conversion-webhook && \
  GO111MODULE=on CGO_ENABLED=0 GOOS=${GOOS} GOPROXY=${GOPROXY} go build \
  -mod=readonly -ldflags="-w -s" -o=/build/capi-ipam-conversion-webhook .

FROM registry.ci.openshift.org/ocp/5.0:base-rhel9

LABEL description="Cluster API Controller Manager"

COPY --from=builder /build/manager /manager
COPY --from=builder /build/capi-ipam-conversion-webhook /capi-ipam-conversion-webhook
COPY openshift/manifests /manifests
COPY openshift/capi-operator-manifests /capi-operator-manifests

ENTRYPOINT [ "/manager" ]

LABEL io.openshift.release.operator true
